# Copia este archivo a .env.local (no se sube al repositorio) y ajusta la sala.

# PostgreSQL del tótem en LAN. En Windows con pgAdmin suele ser el usuario postgres.
DATABASE_URL=postgresql://postgres:TU_CLAVE@127.0.0.1:5432/centro_visitantes_colbun

# Base pública usada por los QR de sala. En LAN debe ser la IP del tótem,
# porque el celular del visitante no resuelve localhost del tótem.
NEXT_PUBLIC_AR_BASE_URL=http://192.168.0.10:3000

# Backoffice del tótem (lib/auth.ts). En sala se reemplaza por usuario.password_hash.
ADMIN_EMAIL=admin@angostura.local
ADMIN_PASSWORD=Angostura2026!
JWT_SECRET=angostura-dev-no-usar-en-sala
